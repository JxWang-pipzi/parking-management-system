.page {
  height: 100vh;
  background-color: #f7f7f7;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  background: linear-gradient(135deg, #07c160 0%, #05a954 100%);
  margin: 0;
  border-radius: 0 0 28rpx 28rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 28rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  margin-bottom: 18rpx;
}

.location-row {
  display: flex;
  align-items: center;
}

.location-prefix {
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  padding: 7rpx 10rpx;
  margin-right: 12rpx;
}

.location-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.location-arrow {
  color: rgba(255, 255, 255, 0.86);
  font-size: 34rpx;
  margin-left: 6rpx;
  line-height: 1;
}

.msg-btn {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-icon {
  width: 40rpx;
  height: 40rpx;
}

.msg-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4444;
  border-radius: 50%;
}

.search-bar {
  display: flex;
  align-items: center;
  width: 100%;
  height: 78rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
}

.search-symbol {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #b8c0ca;
  border-radius: 50%;
  margin-right: 18rpx;
  position: relative;
  flex-shrink: 0;
}

.search-symbol::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 4rpx;
  background-color: #b8c0ca;
  border-radius: 4rpx;
  right: -10rpx;
  bottom: -5rpx;
  transform: rotate(45deg);
}

.search-placeholder {
  font-size: 28rpx;
  color: #a0a7b2;
  flex: 1;
}

.scan-mini {
  color: #07C160;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  padding-left: 18rpx;
  border-left: 1rpx solid #edf0f2;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  align-items: flex-start;
  margin: 22rpx 24rpx 0;
  padding: 26rpx 8rpx 10rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  margin-bottom: 18rpx;
}

.quick-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-icon-img {
  width: 68rpx;
  height: 68rpx;
}

.quick-text {
  font-size: 25rpx;
  color: #333333;
  font-weight: 500;
}

.parking-section {
  margin: 22rpx 24rpx 0;
  padding-bottom: 0;
}

.section-title-row {
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-more {
  font-size: 26rpx;
  color: #4f5965;
}

.filter-tabs {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-tab {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx 24rpx 8rpx 0;
  position: relative;
}

.filter-tab.active {
  color: #07C160;
  font-weight: 600;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 32rpx;
  height: 4rpx;
  background-color: #07C160;
  border-radius: 2rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.parking-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  display: flex;
  padding: 14rpx;
  box-shadow: 0 10rpx 26rpx rgba(26, 43, 62, 0.06);
}

.parking-card:active {
  opacity: 0.85;
}

.card-image-wrap {
  position: relative;
  width: 122rpx;
  height: 122rpx;
  background-color: #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #07C160 0%, #0ea05a 100%);
}

.placeholder-text {
  font-size: 80rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.3);
}

.card-distance-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background-color: #07C160;
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 44rpx;
}

.card-walk-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: rgba(255, 255, 255, 0.95);
  color: #333333;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 44rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
  padding: 2rpx 0 0 18rpx;
}

.card-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 0;
  display: block;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.space-tag {
  font-size: 23rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  color: #07a85a;
  background: #e8f8ef;
  white-space: nowrap;
}

.status-full {
  color: #8f96a3;
  background: #f1f3f5;
}

.status-scarce {
  color: #f06b2f;
  background: #fff1e8;
}

.card-bottom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.card-meta {
  font-size: 24rpx;
  color: #929ba7;
  white-space: nowrap;
}

.card-arrow {
  margin-left: auto;
  color: #b8bec7;
  font-size: 28rpx;
}

.price-line {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-top: 4rpx;
}

.price-symbol {
  font-size: 22rpx;
  color: #FF6B35;
  font-weight: 700;
}

.price-value {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: 700;
  line-height: 1;
}

.price-unit {
  font-size: 23rpx;
  color: #ff8a46;
  margin-left: 2rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.bottom-safe {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.view-all {
  text-align: center;
  color: #6B7280;
  font-size: 26rpx;
  margin-top: 2rpx;
  padding: 18rpx 0 34rpx;
  position: relative;
  z-index: 2;
}
