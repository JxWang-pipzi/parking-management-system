.page {
  height: 100vh;
  background: #f2f5f3;
  color: #10231f;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  position: relative;
  overflow: hidden;
  margin: 0 18rpx;
  padding: 20rpx 28rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
  background:
    radial-gradient(circle at 92% 18%, rgba(184, 242, 78, 0.24) 0, rgba(184, 242, 78, 0) 34%),
    linear-gradient(148deg, #071f1c 0%, #0c3d35 56%, #12624f 100%);
  box-shadow: 0 26rpx 54rpx rgba(6, 38, 32, 0.2);
  box-sizing: border-box;
}

.header::after {
  content: '';
  position: absolute;
  right: -70rpx;
  bottom: -96rpx;
  width: 260rpx;
  height: 260rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.header-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 84rpx;
}

.brand-block,
.hero-copy,
.metric-item {
  display: flex;
  flex-direction: column;
}

.brand-kicker,
.section-kicker {
  display: block;
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  font-weight: 700;
}

.brand-kicker {
  color: #b8f24e;
  margin-bottom: 14rpx;
}

.location-row {
  display: flex;
  align-items: center;
}

.location-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #55e2b0;
  box-shadow: 0 0 0 8rpx rgba(85, 226, 176, 0.12);
}

.location-text {
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
}

.location-arrow {
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  margin-left: 8rpx;
}

.msg-btn {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.msg-icon { width: 34rpx; height: 34rpx; }
.msg-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffb55e;
  border: 3rpx solid #0c3d35;
}

.hero-copy {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.search-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-top: 28rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.14);
  box-sizing: border-box;
}

.search-symbol {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  margin: 0 20rpx 0 4rpx;
  border: 4rpx solid #8b9793;
  border-radius: 50%;
  flex-shrink: 0;
}

.search-symbol::after {
  content: '';
  position: absolute;
  right: -11rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #8b9793;
  transform: rotate(45deg);
}

.search-placeholder { flex: 1; color: #7f8c88; font-size: 27rpx; }
.scan-mini {
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  color: #0b735e;
  background: #e5f7f0;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-metrics {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 18rpx 8rpx 2rpx;
}

.metric-item { flex: 1; align-items: center; }
.metric-value { color: #ffffff; font-size: 30rpx; font-weight: 700; }
.metric-label { color: rgba(255, 255, 255, 0.58); font-size: 20rpx; margin-top: 2rpx; }
.metric-divider { width: 1rpx; height: 46rpx; background: rgba(255, 255, 255, 0.13); }

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 12rpx 12rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(16, 35, 31, 0.06);
  box-shadow: 0 14rpx 40rpx rgba(17, 49, 42, 0.06);
}

.quick-heading {
  width: 100%;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 16rpx 22rpx;
}

.quick-heading-title { font-size: 28rpx; font-weight: 700; color: #10231f; }
.quick-heading-note { font-size: 20rpx; color: #97a19e; }
.quick-item { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 18rpx; }
.quick-icon {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #edf7f3;
  margin-bottom: 10rpx;
}
.quick-icon-img { width: 62rpx; height: 62rpx; }
.quick-text { color: #34433f; font-size: 24rpx; font-weight: 600; }

.parking-section { margin: 30rpx 24rpx 0; }
.section-title-row { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 18rpx; }
.section-kicker { color: #159b78; margin-bottom: 8rpx; }
.section-title { display: block; color: #10231f; font-size: 34rpx; font-weight: 700; }
.section-more { color: #65726e; font-size: 23rpx; padding-bottom: 4rpx; }

.filter-tabs {
  display: flex;
  align-items: center;
  padding: 8rpx;
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  background: #e7ece9;
}
.filter-tab { flex: 1; padding: 12rpx 0; text-align: center; color: #77827f; font-size: 23rpx; border-radius: 14rpx; }
.filter-tab.active { color: #0c4b40; background: #ffffff; font-weight: 700; box-shadow: 0 5rpx 14rpx rgba(26, 66, 57, 0.08); }

.parking-card {
  display: flex;
  padding: 14rpx;
  margin-bottom: 18rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(16, 35, 31, 0.06);
  box-shadow: 0 12rpx 32rpx rgba(20, 55, 47, 0.07);
}
.parking-card:active { transform: scale(0.99); }
.card-image-wrap { position: relative; width: 184rpx; height: 184rpx; border-radius: 20rpx; overflow: hidden; flex-shrink: 0; background: #dce5e1; }
.card-image { width: 100%; height: 100%; }
.card-image-placeholder { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #0b332e, #159b78); }
.placeholder-text { color: rgba(255,255,255,.35); font-size: 70rpx; font-weight: 800; }
.card-content { flex: 1; min-width: 0; padding: 8rpx 6rpx 6rpx 20rpx; }
.card-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 10rpx; }
.card-name { display: block; color: #10231f; font-size: 28rpx; line-height: 1.35; font-weight: 700; }
.space-tag { color: #0b735e; background: #e0f6ee; border-radius: 999rpx; padding: 4rpx 10rpx; font-size: 20rpx; white-space: nowrap; }
.status-full { color: #7e8885; background: #eef1ef; }
.status-scarce { color: #b85b21; background: #fff0e4; }
.card-address { display: block; margin-top: 10rpx; color: #909a97; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-bottom-row { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; }
.card-meta { color: #65726e; font-size: 21rpx; white-space: nowrap; }
.card-arrow { margin-left: auto; color: #a5aeab; font-size: 28rpx; }
.price-line { display: flex; align-items: baseline; justify-content: flex-end; margin-top: 8rpx; }
.price-symbol { color: #f07842; font-size: 20rpx; font-weight: 700; }
.price-value { color: #f07842; font-size: 34rpx; line-height: 1; font-weight: 800; }
.price-unit { color: #9ca5a2; font-size: 20rpx; margin-left: 3rpx; }

.loading-wrap, .empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.loading-spinner { width: 44rpx; height: 44rpx; border: 4rpx solid #dce5e1; border-top-color: #159b78; border-radius: 50%; animation: spin .8s linear infinite; }
.loading-text, .empty-text { margin-top: 16rpx; color: #8e9995; font-size: 24rpx; }
.empty-img { width: 180rpx; height: 180rpx; }
.view-all { text-align: center; color: #65726e; font-size: 24rpx; padding: 20rpx 0 30rpx; }
.bottom-safe { height: calc(154rpx + env(safe-area-inset-bottom)); }
@keyframes spin { to { transform: rotate(360deg); } }
