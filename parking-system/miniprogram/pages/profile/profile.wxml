<view class="profile-page">
  <view class="header" style="padding-top: {{statusBarHeight}}px">
    <view class="header-content">
      <block wx:if="{{isLoggedIn}}">
        <view class="user-row">
          <view class="avatar-outer">
            <image wx:if="{{userInfo.avatar}}" class="avatar-image" src="{{userInfo.avatar}}" mode="aspectFill"></image>
            <view wx:else class="avatar-inner">{{avatarText}}</view>
          </view>
          <view class="user-info">
            <text class="user-name">{{userInfo.name || '用户昵称'}}</text>
            <text class="user-phone">{{displayAccount || '已登录'}}</text>
          </view>
          <view class="header-icon-btn" bindtap="navigateToSettings">
            <image class="header-icon" src="/images/profile-settings.svg" mode="aspectFit"></image>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="user-row">
          <view class="avatar-outer">
            <view class="avatar-inner avatar-inner-default">?</view>
          </view>
          <view class="user-info">
            <text class="user-name">点击登录</text>
            <text class="user-phone">登录后享受更多服务</text>
          </view>
          <view class="header-icon-btn">
            <image class="header-icon" src="/images/profile-settings.svg" mode="aspectFit"></image>
          </view>
        </view>
        <view class="guest-actions">
          <view class="guest-action-btn guest-login-btn" bindtap="navigateToLogin">
            <image class="guest-btn-icon" src="/images/btn-login.png" mode="aspectFit"></image>
            <text>登录</text>
          </view>
          <view class="guest-action-btn guest-register-btn" bindtap="navigateToRegister">
            <image class="guest-btn-icon" src="/images/btn-register.png" mode="aspectFit"></image>
            <text>注册</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="benefit-card">
    <view class="benefit-left">
      <text class="benefit-title">开通月卡</text>
      <text class="benefit-subtitle">享受更多停车优惠</text>
    </view>
    <view class="benefit-btn" bindtap="navigateToMonthlyCard">
      <image class="benefit-btn-icon" src="/images/btn-month-card.png" mode="aspectFit"></image>
      <text>去开通</text>
    </view>
  </view>

  <view class="panel-section order-section">
    <view class="section-title-row">
      <text class="section-title">我的订单</text>
      <text class="section-more" bindtap="navigateToOrders">全部订单</text>
    </view>
    <view class="order-grid">
      <view class="order-entry" bindtap="navigateToOrders">
        <view class="order-icon">待</view>
        <text class="order-label">待付款</text>
      </view>
      <view class="order-entry" bindtap="navigateToOrders">
        <view class="order-icon paid">付</view>
        <text class="order-label">已付款</text>
      </view>
      <view class="order-entry" bindtap="navigateToOrders">
        <view class="order-icon parking">停</view>
        <text class="order-label">停车中</text>
      </view>
      <view class="order-entry" bindtap="navigateToOrders">
        <view class="order-icon done">完</view>
        <text class="order-label">已完成</text>
      </view>
    </view>
  </view>

  <view class="panel-section car-section">
    <view class="section-title-row">
      <text class="section-title">我的车辆</text>
      <text class="section-more" bindtap="navigateToAddCar" wx:if="{{isLoggedIn}}">+ 添加车辆</text>
    </view>
    <text class="section-desc">可添加多辆车，预约停车时支持手动选择或自动填充默认车辆。</text>
    <view class="car-card">
      <block wx:if="{{vehicles.length > 0}}">
        <view class="car-item" wx:for="{{vehicles}}" wx:key="id" bindtap="navigateToMyCars">
          <view class="car-info">
            <text class="car-plate">{{item.displayPlate || item.plateNumber}}</text>
            <view class="car-tags">
              <text class="car-default-tag" wx:if="{{item.isDefault === 1}}">默认</text>
              <text class="car-brand-tag" wx:if="{{item.brand}}">{{item.brand}}</text>
              <text class="car-color-tag" wx:if="{{item.color}}">{{item.color}}</text>
            </view>
          </view>
          <view class="car-actions">
            <view class="car-action-btn" wx:if="{{item.isDefault !== 1}}" catchtap="onSetDefaultVehicle" data-id="{{item.id}}">设默认</view>
            <view class="car-action-btn car-delete-btn" catchtap="onDeleteVehicle" data-id="{{item.id}}" data-plate="{{item.plateNumber}}">删除</view>
          </view>
        </view>
      </block>
      <view wx:elif="{{isLoggedIn}}" class="car-item car-empty" bindtap="navigateToAddCar">
        <view class="car-info">
          <text class="car-empty-text">暂无车辆，点击添加</text>
        </view>
        <text class="arrow-text">›</text>
      </view>
      <view wx:else class="car-item car-empty" bindtap="navigateToLogin">
        <view class="car-info">
          <text class="car-empty-text">登录后管理车辆</text>
        </view>
        <text class="arrow-text">›</text>
      </view>
      <view wx:if="{{isLoggedIn && vehicles.length > 0}}" class="add-car" bindtap="navigateToAddCar">
        <image class="add-car-icon" src="/images/btn-add-car.png" mode="aspectFit"></image>
        <text class="add-car-text">添加新车辆</text>
        <text class="arrow-text add-car-arrow">›</text>
      </view>
      <view wx:elif="{{!isLoggedIn}}" class="add-car" bindtap="navigateToLogin">
        <text class="add-car-text">立即登录</text>
        <text class="arrow-text add-car-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title-row section-title-row-inner">
      <text class="section-title">我的服务</text>
    </view>
    <view class="menu-card">
      <view class="menu-item" bindtap="navigateToCoupons">
        <view class="menu-left">
          <image class="menu-icon" src="/images/profile-coupon.svg" mode="aspectFit"></image>
          <text class="menu-text">我的优惠券</text>
        </view>
        <view class="menu-right">
          <text class="menu-value">5张可用</text>
          <text class="arrow-text">›</text>
        </view>
      </view>
      <view class="menu-item" bindtap="navigateToPayment">
        <view class="menu-left">
          <image class="menu-icon" src="/images/profile-nopay.svg" mode="aspectFit"></image>
          <text class="menu-text">无感支付</text>
        </view>
        <view class="menu-right">
          <text class="menu-value">去开通</text>
          <text class="arrow-text">›</text>
        </view>
      </view>
      <view class="menu-item" bindtap="navigateToInvoice">
        <view class="menu-left">
          <image class="menu-icon" src="/images/profile-invoice.svg" mode="aspectFit"></image>
          <text class="menu-text">发票管理</text>
        </view>
        <view class="menu-right">
          <text class="arrow-text">›</text>
        </view>
      </view>
      <view class="menu-item menu-item-last" bindtap="navigateToAddress">
        <view class="menu-left">
          <image class="menu-icon" src="/images/profile-location.svg" mode="aspectFit"></image>
          <text class="menu-text">常用地址</text>
        </view>
        <view class="menu-right">
          <text class="arrow-text">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-section menu-section-tight">
    <view class="section-title-row section-title-row-inner">
      <text class="section-title">帮助与关于</text>
    </view>
    <view class="menu-card">
      <view class="menu-item" bindtap="navigateToFeedback">
        <view class="menu-left">
          <image class="menu-icon" src="/images/profile-help.svg" mode="aspectFit"></image>
          <text class="menu-text">帮助与反馈</text>
        </view>
        <view class="menu-right">
          <text class="arrow-text">›</text>
        </view>
      </view>
      <view class="menu-item menu-item-last" bindtap="navigateToAbout">
        <view class="menu-left">
          <image class="menu-icon" src="/images/profile-about.svg" mode="aspectFit"></image>
          <text class="menu-text">关于我们</text>
        </view>
        <view class="menu-right">
          <text class="arrow-text">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="logout-wrap" wx:if="{{isLoggedIn}}">
    <view class="logout-btn" bindtap="handleLogout">退出登录</view>
  </view>

  <view class="bottom-safe"></view>
</view>
