.profile-page { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); background: #f2f5f3; color: #10231f; }
.header { position: relative; overflow: hidden; padding: 24rpx 28rpx 104rpx; border-radius: 0 0 42rpx 42rpx; background: radial-gradient(circle at 90% 15%,rgba(184,242,78,.22),transparent 34%),linear-gradient(145deg,#071f1c,#0b3b34 62%,#12604e); box-shadow: 0 22rpx 46rpx rgba(7,39,33,.16); }
.header::after { content: ''; position: absolute; right: -80rpx; bottom: -120rpx; width: 300rpx; height: 300rpx; border: 1rpx solid rgba(255,255,255,.07); border-radius: 50%; }
.header-content { position: relative; z-index: 2; }
.profile-kicker { display: block; margin-bottom: 22rpx; color: #b8f24e; font-size: 19rpx; letter-spacing: 4rpx; font-weight: 700; }
.user-row { display: flex; align-items: center; }
.avatar-outer { width: 92rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; background: rgba(255,255,255,.12); border: 1rpx solid rgba(255,255,255,.14); }
.avatar-inner, .avatar-image { width: 76rpx; height: 76rpx; border-radius: 24rpx; }
.avatar-inner { display: flex; align-items: center; justify-content: center; color: #0b4c40; background: #b8f24e; font-size: 32rpx; font-weight: 800; }
.avatar-inner-default { color: #6d7874; background: rgba(255,255,255,.86); }
.user-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; margin-left: 20rpx; }
.user-name { color: #ffffff; font-size: 32rpx; font-weight: 700; }
.user-phone { color: rgba(255,255,255,.62); font-size: 22rpx; }
.header-icon-btn { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: rgba(255,255,255,.1); border: 1rpx solid rgba(255,255,255,.12); }
.header-icon { width: 31rpx; height: 31rpx; }
.guest-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }
.guest-action-btn { min-width: 170rpx; padding: 15rpx 0; display: flex; align-items: center; justify-content: center; gap: 8rpx; border-radius: 20rpx; font-size: 25rpx; font-weight: 700; }
.guest-login-btn { color: #0b4c40; background: #b8f24e; }
.guest-register-btn { color: #ffffff; background: rgba(255,255,255,.08); border: 1rpx solid rgba(255,255,255,.2); }
.guest-btn-icon { width: 32rpx; height: 32rpx; }

.benefit-card { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; margin: -64rpx 24rpx 22rpx; padding: 25rpx 24rpx; border-radius: 28rpx; background: linear-gradient(120deg,#f2ffd7,#dff6e9); border: 1rpx solid rgba(21,155,120,.14); box-shadow: 0 16rpx 38rpx rgba(18,52,44,.11); }
.benefit-left { display: flex; flex-direction: column; gap: 5rpx; }
.benefit-eyebrow { color: #159b78; font-size: 17rpx; letter-spacing: 3rpx; font-weight: 800; }
.benefit-title { color: #10231f; font-size: 29rpx; font-weight: 700; }
.benefit-subtitle { color: #68746f; font-size: 20rpx; }
.benefit-btn { min-width: 108rpx; padding: 11rpx 16rpx; display: flex; align-items: center; justify-content: center; gap: 6rpx; border-radius: 16rpx; color: #ffffff; background: #0b3b34; font-size: 23rpx; font-weight: 700; }
.benefit-btn-icon { width: 31rpx; height: 31rpx; }

.panel-section,.car-section,.menu-section,.logout-wrap { margin: 0 24rpx 20rpx; }
.section-title-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 13rpx; }
.section-title-row-inner { margin-bottom: 12rpx; }
.section-title { color: #10231f; font-size: 28rpx; font-weight: 700; }
.section-more { color: #159b78; font-size: 23rpx; font-weight: 600; }
.section-desc { display: block; margin: -3rpx 0 12rpx; color: #87928e; font-size: 21rpx; line-height: 1.55; }

.order-grid,.car-card,.menu-card,.logout-btn { background: #ffffff; border: 1rpx solid rgba(16,35,31,.05); box-shadow: 0 12rpx 30rpx rgba(18,52,44,.06); }
.order-grid { display: grid; grid-template-columns: repeat(4,1fr); padding: 22rpx 8rpx; border-radius: 26rpx; }
.order-entry { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.order-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; color: #0b735e; background: #e0f6ee; font-size: 22rpx; font-weight: 800; }
.order-icon.paid { color: #2563a8; background: #e7f1fb; }
.order-icon.parking { color: #b76129; background: #fff0e4; }
.order-icon.done { color: #68746f; background: #edf1ef; }
.order-label { color: #465550; font-size: 22rpx; }

.car-card,.menu-card { overflow: hidden; border-radius: 26rpx; }
.car-item { display: flex; align-items: center; justify-content: space-between; padding: 21rpx 24rpx; border-bottom: 1rpx solid #edf1ef; }
.car-info { min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.car-plate { color: #10231f; font-size: 29rpx; font-weight: 700; }
.car-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 7rpx; }
.car-default-tag,.car-brand-tag,.car-color-tag { padding: 4rpx 9rpx; border-radius: 9rpx; font-size: 19rpx; }
.car-default-tag { color: #0b735e; background: #e0f6ee; }
.car-brand-tag { color: #2563a8; background: #e7f1fb; }
.car-color-tag { color: #68746f; background: #edf1ef; }
.car-empty-text { color: #96a09c; font-size: 25rpx; }
.car-actions { display: flex; align-items: center; gap: 9rpx; }
.car-action-btn { padding: 6rpx 13rpx; border: 1rpx solid #159b78; border-radius: 999rpx; color: #159b78; font-size: 20rpx; }
.car-delete-btn { color: #cf5353; border-color: #cf5353; }
.add-car { display: flex; align-items: center; gap: 8rpx; padding: 18rpx 24rpx 21rpx; }
.add-car-icon { width: 30rpx; height: 30rpx; }
.add-car-text { color: #159b78; font-size: 24rpx; font-weight: 600; }
.add-car-arrow { margin-left: 1rpx; }
.arrow-text { color: #a6afac; font-size: 30rpx; line-height: 1; }

.menu-section-tight { margin-bottom: 24rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 24rpx; border-bottom: 1rpx solid #edf1ef; }
.menu-item:active { background: #f6f9f7; }
.menu-item-last { border-bottom: none; }
.menu-left,.menu-right { display: flex; align-items: center; }
.menu-left { gap: 16rpx; }
.menu-right { gap: 8rpx; }
.menu-icon { width: 31rpx; height: 31rpx; }
.menu-text { color: #30423d; font-size: 25rpx; }
.menu-value { color: #8e9995; font-size: 21rpx; }
.logout-btn { padding: 22rpx 0; border-radius: 24rpx; color: #c34f4f; font-size: 27rpx; font-weight: 700; text-align: center; }
.bottom-safe { height: 12rpx; }
