.profile-page {
  min-height: 100vh;
  background-color: #f6f8f7;
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.header {
  background: linear-gradient(135deg, #06b46f 0%, #009d59 100%);
  padding: 22rpx 24rpx 104rpx;
  border-radius: 0 0 18rpx 18rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar-outer {
  width: 84rpx;
  height: 84rpx;
  background-color: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-inner {
  width: 70rpx;
  height: 70rpx;
  background-color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #18B566;
  font-size: 34rpx;
  font-weight: 600;
}

.avatar-image {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
}

.avatar-inner-default {
  color: #9ca3af;
}

.user-info {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-phone {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.86);
}

.header-icon-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-icon {
  width: 34rpx;
  height: 34rpx;
}

.guest-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.guest-action-btn {
  min-width: 180rpx;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.guest-login-btn {
  background-color: #ffffff;
  color: #18B566;
}

.guest-register-btn {
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  color: #ffffff;
}

.benefit-card {
  margin: -54rpx 24rpx 22rpx;
  border-radius: 10rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(90deg, #FFF6E7 0%, #FCE7C2 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.08);
  position: relative;
  z-index: 2;
}

.benefit-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.benefit-title {
  font-size: 24rpx;
  color: #1F2937;
  font-weight: 700;
}

.benefit-subtitle {
  font-size: 18rpx;
  color: #6B7280;
}

.benefit-btn {
  min-width: 112rpx;
  text-align: center;
  padding: 14rpx 24rpx;
  border-radius: 18rpx;
  background-color: #6B4A26;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.car-section {
  margin: 0 24rpx 18rpx;
}

.section-title-row {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #1F2937;
}

.car-card {
  background-color: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.car-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.car-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.car-plate {
  font-size: 22rpx;
  color: #111827;
  font-weight: 600;
}

.car-default-tag {
  font-size: 18rpx;
  color: #18B566;
  background-color: rgba(24, 181, 102, 0.12);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.car-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.car-brand-tag {
  font-size: 20rpx;
  color: #4A90E2;
  background-color: rgba(74, 144, 226, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.car-color-tag {
  font-size: 20rpx;
  color: #6b7280;
  background-color: #f3f4f6;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.car-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.car-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.car-action-btn {
  font-size: 22rpx;
  color: #18B566;
  padding: 6rpx 16rpx;
  border: 2rpx solid #18B566;
  border-radius: 20rpx;
}

.car-delete-btn {
  color: #ef4444;
  border-color: #ef4444;
}

.section-more {
  font-size: 24rpx;
  color: #18B566;
  margin-left: auto;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.55;
}

.add-car {
  padding: 16rpx 24rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.add-car-text {
  font-size: 24rpx;
  color: #3B82F6;
}

.add-car-arrow {
  width: 18rpx;
  height: 18rpx;
  opacity: 0.5;
}

.menu-section {
  margin: 0 24rpx 18rpx;
}

.menu-section-tight {
  margin-bottom: 24rpx;
}

.logout-wrap {
  margin: 0 24rpx;
}

.logout-btn {
  background-color: #ffffff;
  color: #ef4444;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.menu-card {
  background-color: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.menu-item:active {
  background-color: #f9fafb;
}

.menu-item-last {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.menu-text {
  font-size: 22rpx;
  color: #20242E;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-value {
  font-size: 20rpx;
  color: #8F96A3;
}

.arrow-icon-sm {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.55;
}

.bottom-safe {
  height: 12rpx;
}
