<view class="page">
  <view class="title-bar" style="padding-top: {{statusBarHeight}}px">
    <text class="title-text">订单记录</text>
  </view>

  <view class="tab-bar">
    <view class="tab {{activeTab === 'all' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="all">
      <text class="tab-text">全部</text>
    </view>
    <view class="tab {{activeTab === 'active' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="active">
      <text class="tab-text">进行中</text>
    </view>
    <view class="tab {{activeTab === 'completed' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="completed">
      <text class="tab-text">已完成</text>
    </view>
    <view class="tab {{activeTab === 'cancel' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="cancel">
      <text class="tab-text">已取消</text>
    </view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="empty-shell">
    <view class="empty-card">
      <text class="empty-title">登录后查看订单记录</text>
      <text class="empty-desc">历史停车订单、进行中订单都会展示在这里</text>
      <button class="empty-btn" bindtap="goLogin">立即登录</button>
    </view>
  </view>

  <scroll-view wx:elif="{{orders.length > 0 || loading}}" scroll-y class="order-scroll">
    <view class="order-list">
      <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-status="{{item.status}}">
        <view class="order-top">
          <text class="lot-name">{{item.parkingLotName || '未知停车场'}}</text>
          <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="order-meta">
          <text class="plate-text">{{item.plateNumber || '京A · 12345'}}</text>
        </view>
        <view class="time-row">
          <text class="time-label">入场时间</text>
          <text class="time-value">{{item.startTime || '--'}}</text>
        </view>
        <view class="time-row">
          <text class="time-label">出场时间</text>
          <text class="time-value">{{item.endTime || '--'}}</text>
        </view>
        <view class="order-bottom">
          <view class="amount-box {{item.status === 2 ? 'amount-box-muted' : ''}} {{item.isFreeOrder ? 'amount-box-free' : ''}}">
            <text wx:if="{{!item.isFreeOrder}}" class="amount-sign">¥</text>
            <text class="amount-value">{{item.amountText}}</text>
          </view>
        </view>
        <view class="order-actions" wx:if="{{item.status === 0 || item.status === 3}}">
          <button wx:if="{{item.status === 0}}" class="action-btn secondary" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
          <button wx:if="{{item.status === 0}}" class="action-btn primary" catchtap="payOrder" data-id="{{item.id}}" data-amount="{{item.amountText}}" data-status="{{item.status}}">立即支付</button>
          <button wx:if="{{item.status === 3}}" class="action-btn primary wide" catchtap="completeOrder" data-id="{{item.id}}">支付并离场</button>
        </view>
      </view>

      <view class="loading-wrap" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
      </view>

      <view class="no-more" wx:if="{{!loading && orders.length > 0}}">没有更多了</view>
    </view>
  </scroll-view>

  <view wx:else class="empty-shell">
    <view class="empty-card empty-card-soft">
      <text class="empty-title">暂无订单记录</text>
      <text class="empty-desc">你还没有停车订单，去首页看看附近车场吧</text>
      <button class="empty-btn" bindtap="goParkingHome">去找车位</button>
    </view>
  </view>
</view>
