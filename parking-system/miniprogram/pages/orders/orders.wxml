<view class="page">
  <view class="orders-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="title-bar">
      <view>
        <text class="title-kicker">ORDER CENTER</text>
        <text class="title-text">停车订单</text>
      </view>
      <text wx:if="{{orders.length > 0 || selectionMode}}" class="manage-text" bindtap="toggleSelectionMode">{{selectionMode ? '取消' : '管理'}}</text>
    </view>

    <view class="order-search">
      <view class="search-symbol"></view>
      <input
        class="order-search-input"
        placeholder="搜索停车场、车牌、订单号"
        placeholder-class="order-search-placeholder"
        bindinput="onSearchInput"
        value="{{keyword}}"
        confirm-type="search"
      ></input>
      <view class="order-clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">
        <text class="order-clear-icon">×</text>
      </view>
    </view>

    <view class="tab-bar">
      <view class="tab {{activeTab === 'all' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="all">
        <text class="tab-text">全部</text>
      </view>
      <view class="tab {{activeTab === 'active' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="active">
        <text class="tab-text">进行中</text>
      </view>
      <view class="tab {{activeTab === 'completed' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="completed">
        <text class="tab-text">已完成</text>
      </view>
      <view class="tab {{activeTab === 'cancel' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="cancel">
        <text class="tab-text">已取消</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="empty-shell" style="padding-top: {{navHeight}}px">
    <view class="empty-card transparent-empty-card">
      <text class="empty-title">登录后查看订单记录</text>
      <text class="empty-desc">历史停车订单、进行中订单都会展示在这里</text>
      <button class="empty-btn" bindtap="goLogin">
        <image class="btn-img" src="/images/btn-login.png" mode="aspectFit"></image>
        <text>立即登录</text>
      </button>
    </view>
  </view>

  <scroll-view wx:elif="{{orders.length > 0 || loading}}" scroll-y class="order-scroll" style="padding-top: {{navHeight}}px">
    <view class="order-list">
      <view class="order-card {{selectionMode ? 'order-card-selecting' : ''}} {{selectedOrderIdMap[item.id] ? 'order-card-selected' : ''}}" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-status="{{item.status}}">
        <view wx:if="{{selectionMode}}" class="select-control {{selectedOrderIdMap[item.id] ? 'selected' : ''}} {{item.status === 1 || item.status === 2 ? '' : 'disabled'}}" catchtap="toggleSelectOrder" data-id="{{item.id}}" data-status="{{item.status}}">
          <text wx:if="{{selectedOrderIdMap[item.id]}}">✓</text>
        </view>
        <view class="order-top">
          <text class="lot-name">{{item.parkingLotName || '未知停车场'}}</text>
          <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="order-meta">
          <text class="plate-text">{{item.plateNumber || '京A · 12345'}}</text>
        </view>
        <view class="time-row">
          <text class="time-label">入场时间</text>
          <text class="time-value">{{item.startTime || '--'}}</text>
        </view>
        <view class="time-row">
          <text class="time-label">出场时间</text>
          <text class="time-value">{{item.endTime || '--'}}</text>
        </view>
        <view class="order-bottom">
          <view class="amount-box {{item.status === 2 ? 'amount-box-muted' : ''}} {{item.isFreeOrder ? 'amount-box-free' : ''}}">
            <text wx:if="{{!item.isFreeOrder}}" class="amount-sign">¥</text>
            <text class="amount-value">{{item.amountText}}</text>
          </view>
        </view>
        <view class="order-actions" wx:if="{{!selectionMode && (item.status === 0 || item.status === 3)}}">
          <button wx:if="{{item.status === 0}}" class="action-btn secondary" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
          <button wx:if="{{item.status === 0}}" class="action-btn primary" catchtap="payOrder" data-id="{{item.id}}" data-amount="{{item.amountText}}" data-status="{{item.status}}">
            <image class="action-btn-img" src="/images/btn-pay-white.png" mode="aspectFit"></image>
            <text>立即支付</text>
          </button>
          <button wx:if="{{item.status === 3}}" class="action-btn primary wide" catchtap="completeOrder" data-id="{{item.id}}">
            <image class="action-btn-img" src="/images/btn-pay-white.png" mode="aspectFit"></image>
            <text>支付并离场</text>
          </button>
        </view>
        <view class="order-actions delete-row" wx:elif="{{!selectionMode}}">
          <button class="action-btn delete" catchtap="deleteOrder" data-id="{{item.id}}">删除记录</button>
        </view>
      </view>

      <view class="loading-wrap" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
      </view>

      <view class="no-more" wx:if="{{!loading && orders.length > 0}}">没有更多了</view>
    </view>
  </scroll-view>

  <view wx:else class="empty-shell" style="padding-top: {{navHeight}}px">
    <view class="empty-card transparent-empty-card">
      <text class="empty-title">{{keyword ? '未找到相关订单' : '暂无订单记录'}}</text>
      <text class="empty-desc">{{keyword ? '换个停车场、车牌或订单号试试' : '你还没有停车订单，去首页看看附近车场吧'}}</text>
      <button class="empty-btn" bindtap="goParkingHome">
        <image class="btn-img" src="/images/btn-nearby-parking.png" mode="aspectFit"></image>
        <text>去找车位</text>
      </button>
    </view>
  </view>

  <view wx:if="{{selectionMode}}" class="batch-bar">
    <view class="batch-select" bindtap="selectAllVisible">
      <text class="batch-check {{allVisibleSelected ? 'selected' : ''}}">{{allVisibleSelected ? '✓' : ''}}</text>
      <text>全选</text>
    </view>
    <text class="batch-count">已选 {{selectedOrderIds.length}} 条</text>
    <button class="batch-delete" bindtap="deleteSelectedOrders" disabled="{{selectedOrderIds.length === 0}}">批量删除</button>
  </view>
</view>
