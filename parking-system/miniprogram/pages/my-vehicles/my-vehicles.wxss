.page {
  min-height: 100vh;
  background-color: #f7f7f7;
}

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.header-add {
  font-size: 28rpx;
  color: #18B566;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border: 2rpx solid #18B566;
  border-radius: 28rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #18B566;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.vehicle-card {
  margin: 20rpx 24rpx;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 20rpx;
}

.plate-box {
  background: linear-gradient(135deg, #18B566 0%, #15a05a 100%);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  min-width: 200rpx;
  text-align: center;
}

.plate-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.card-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag-default {
  font-size: 22rpx;
  color: #18B566;
  background-color: rgba(24, 181, 102, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.tag-color {
  font-size: 22rpx;
  color: #6b7280;
  background-color: #f3f4f6;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f3f4f6;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-weight: 500;
}

.action-edit {
  color: #4A90E2;
  background-color: rgba(74, 144, 226, 0.08);
}

.action-delete {
  color: #ef4444;
  background-color: rgba(239, 68, 68, 0.08);
}

.action-setdefault {
  color: #18B566;
  background-color: rgba(24, 181, 102, 0.08);
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 28rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}

.empty-add-btn {
  background-color: #18B566;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 60rpx;
  border-radius: 44rpx;
}