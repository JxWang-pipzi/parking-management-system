<view class="page" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-back glass-back-btn" bindtap="goBack">
      <text class="nav-back-arrow">‹</text>
    </view>
    <text class="nav-title">{{isEdit ? '编辑车辆' : '添加车辆'}}</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">车牌号 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入车牌号，如：京A12345" value="{{plateNumber}}" bindinput="onPlateInput" maxlength="8" />
    </view>
    <view class="form-item">
      <text class="form-label">品牌</text>
      <input class="form-input" placeholder="如：特斯拉、宝马、比亚迪" value="{{brand}}" bindinput="onBrandInput" maxlength="20" />
    </view>
    <view class="form-item">
      <text class="form-label">颜色</text>
      <view class="color-options">
        <view class="color-option {{selectedColor === item.value ? 'active' : ''}}" wx:for="{{colors}}" wx:key="value" data-value="{{item.value}}" bindtap="onColorTap" style="background-color: {{item.bg}}"></view>
        <view class="color-option color-custom {{isCustomColor ? 'active' : ''}}" bindtap="onCustomColorTap">
          <text class="custom-icon">+</text>
        </view>
      </view>
    </view>

    <view class="default-row" bindtap="onDefaultToggle">
      <view class="checkbox-wrap {{isDefault ? 'checked' : ''}}">
        <view class="checkbox-inner" wx:if="{{isDefault}}">✓</view>
      </view>
      <text class="default-text">设为默认车辆</text>
    </view>

    <view class="submit-btn" bindtap="handleSubmit">
      <image class="submit-btn-icon" src="/images/btn-add-car-white.png" mode="aspectFit"></image>
      <text>{{submitting ? (isEdit ? '保存中...' : '提交中...') : (isEdit ? '保存修改' : '确认添加')}}</text>
    </view>
  </view>

  <view class="tips-card">
    <text class="tips-title">温馨提示</text>
    <text class="tips-text">1. 车牌号将用于预约停车时自动填充</text>
    <text class="tips-text">2. 设为默认车辆后，预约时会优先使用该车牌</text>
    <text class="tips-text">3. 可在"我的车辆"中管理或删除已添加的车辆</text>
  </view>
</view>
