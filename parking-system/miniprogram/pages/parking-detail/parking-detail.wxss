.page {
  height: 100vh;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.top-nav {
  height: 106rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.top-actions {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.top-icon {
  color: #17202a;
  font-size: 36rpx;
}

.banner-wrap {
  width: auto;
  height: 376rpx;
  margin: 0 16rpx;
  position: relative;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-error {
  width: 100%;
  height: 100%;
  background-color: #e5e7eb;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 48rpx;
  color: #111827;
  font-weight: 300;
  line-height: 1;
}

.main-scroll {
  flex: 1;
  min-height: 0;
}

.info-card {
  margin: -34rpx 16rpx 0;
  padding: 28rpx 28rpx 26rpx;
  background-color: #ffffff;
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 10rpx 26rpx rgba(28, 44, 62, 0.08);
  position: relative;
  z-index: 10;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.park-name {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #111827;
}

.available-pill {
  color: #08a95c;
  background: #e9f8f0;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  font-size: 20rpx;
}

.meta-line {
  display: flex;
  gap: 24rpx;
  color: #8a94a2;
  font-size: 22rpx;
  margin-top: 12rpx;
}

.address-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.price-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B35;
  line-height: 1.1;
}

.price-unit {
  font-size: 20rpx;
  color: #9ca3af;
  margin-left: 4rpx;
}

.price-note {
  font-size: 20rpx;
  color: #ff7d35;
  margin-left: 8rpx;
}

.price-more {
  margin-left: auto;
  font-size: 18rpx;
  color: #8a94a2;
}

.space-card,
.service-card {
  margin: 0 16rpx;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 0;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.035);
  border-top: 1rpx solid #EEF2F4;
}

.space-stats {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: #8d96a3;
}

.stat-value {
  display: block;
  font-size: 24rpx;
  color: #111827;
  margin-top: 8rpx;
}

.big-free {
  color: #08a95c;
  font-size: 54rpx;
  font-weight: 800;
}

.big-unit {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.distance-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 24rpx;
  margin-top: 22rpx;
  border-top: 1rpx solid #edf0f2;
}

.address-text {
  font-size: 22rpx;
  color: #4f5965;
}

.distance-value {
  font-size: 20rpx;
  color: #8d96a3;
}

.mini-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.mini-btn {
  margin: 0;
  width: 128rpx;
  height: 48rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #08a95c;
  background: #e9f8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.section-head {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: #111827;
  font-weight: 600;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
}

.service-card {
  border-radius: 0 0 22rpx 22rpx;
  margin-bottom: 22rpx;
}

.service-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.service-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.icon-available {
  background-color: rgba(24, 181, 102, 0.1);
  color: #18B566;
}

.icon-unavailable {
  background-color: #f1f5f9;
  color: #94a3b8;
}

.service-name {
  font-size: 20rpx;
  color: #374151;
  text-align: center;
}

.name-unavailable {
  color: #94a3b8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 14rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 99;
}

.bottom-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 10rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.bottom-btn::after {
  border: none;
}

.btn-nav {
  background-color: #ffffff;
  color: #08a95c;
  border: 2rpx solid #08a95c;
}

.btn-park {
  background-color: #18B566;
  color: #ffffff;
}

.reserve-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.reserve-modal {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-drag-bar {
  width: 80rpx;
  height: 8rpx;
  background-color: #d1d5db;
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

.modal-heading {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
  margin-bottom: 36rpx;
}

.vehicle-selector-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.vehicle-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.vehicle-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.vehicle-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #f3f4f6;
  border: 3rpx solid transparent;
  border-radius: 28rpx;
  padding: 14rpx 22rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.vehicle-chip.active {
  background-color: rgba(24, 181, 102, 0.1);
  border-color: #18B566;
}

.chip-plate {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.vehicle-chip.active .chip-plate {
  color: #18B566;
}

.chip-default-tag {
  font-size: 18rpx;
  color: #18B566;
  background-color: rgba(24, 181, 102, 0.15);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.form-item {
  margin-bottom: 28rpx;
}

.field-title {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.field-price {
  display: block;
  font-size: 28rpx;
  color: #18B566;
  font-weight: 600;
  line-height: 84rpx;
  padding-left: 4rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.modal-btn::after {
  border: none;
}

.btn-cancel {
  background-color: #ffffff;
  color: #6b7280;
  border: 2rpx solid #d1d5db;
}

.btn-confirm {
  background-color: #18B566;
  color: #ffffff;
}

.btn-confirm[disabled] {
  background-color: #9fd9b8;
  color: #ffffff;
}
