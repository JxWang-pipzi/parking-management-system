.page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f1f4f2; color: #10231f; }
.top-nav { height: 102rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; background: #f1f4f2; }
.top-actions { display: flex; align-items: center; gap: 16rpx; }
.top-icon { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; color: #10231f; background: #ffffff; border: 1rpx solid #e1e7e4; font-size: 32rpx; box-shadow: 0 8rpx 22rpx rgba(18,49,42,.06); }
.back-btn { display: flex; align-items: center; justify-content: center; }
.back-arrow { color: inherit; font-size: 42rpx; font-weight: 300; line-height: 1; }

.banner-wrap { position: relative; width: auto; height: 390rpx; margin: 0 18rpx; overflow: hidden; border-radius: 34rpx; flex-shrink: 0; background: #123f36; box-shadow: 0 24rpx 46rpx rgba(11,51,46,.18); }
.banner-img, .banner-error { width: 100%; height: 100%; }
.banner-error { background: linear-gradient(145deg,#0b332e,#159b78); }
.banner-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg,rgba(6,27,24,.08),rgba(6,27,24,.72)); }
.hero-badge { position: absolute; left: 26rpx; bottom: 30rpx; display: flex; flex-direction: column; }
.hero-badge-kicker { color: #b8f24e; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 700; }
.hero-badge-title { margin-top: 8rpx; color: #ffffff; font-size: 28rpx; font-weight: 700; }

.main-scroll { flex: 1; min-height: 0; }
.info-card { position: relative; z-index: 10; margin: -30rpx 24rpx 0; padding: 30rpx 28rpx 26rpx; border-radius: 30rpx; background: #ffffff; border: 1rpx solid rgba(16,35,31,.05); box-shadow: 0 16rpx 38rpx rgba(17,53,45,.1); }
.title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.title-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.detail-kicker { color: #159b78; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 700; }
.park-name { display: block; margin-top: 8rpx; color: #10231f; font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.available-pill { margin-top: 4rpx; padding: 7rpx 13rpx; border-radius: 999rpx; color: #0b735e; background: #e0f6ee; font-size: 21rpx; white-space: nowrap; }
.meta-line { display: flex; gap: 22rpx; margin-top: 12rpx; color: #88938f; font-size: 23rpx; }
.address-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6rpx; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #edf1ef; }
.price-value { color: #ef7941; font-size: 42rpx; line-height: 1; font-weight: 800; }
.price-unit { color: #98a29f; font-size: 22rpx; }
.price-note { color: #6f7b77; font-size: 22rpx; margin-left: 8rpx; }
.price-more { margin-left: auto; color: #159b78; font-size: 22rpx; font-weight: 600; }
.basic-note { color: #159b78; font-size: 25rpx; font-weight: 700; }

.space-card, .service-card { margin: 20rpx 24rpx 0; padding: 28rpx; border-radius: 28rpx; background: #ffffff; border: 1rpx solid rgba(16,35,31,.05); box-shadow: 0 12rpx 32rpx rgba(17,53,45,.06); }
.section-label-row { display: flex; align-items: center; gap: 12rpx; }
.section-index { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; color: #ffffff; background: #0b3b34; font-size: 18rpx; font-weight: 700; }
.section-title { color: #10231f; font-size: 29rpx; font-weight: 700; }
.space-stats { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 26rpx; padding: 22rpx; border-radius: 22rpx; background: #f2f8f5; }
.stat-label { display: block; color: #88938f; font-size: 21rpx; }
.stat-value { display: block; margin-top: 6rpx; color: #10231f; font-size: 30rpx; font-weight: 700; }
.big-free { color: #0d8f70; font-size: 54rpx; line-height: 1; font-weight: 800; }
.big-unit { margin-left: 4rpx; font-size: 22rpx; }
.distance-row { display: flex; flex-direction: column; gap: 7rpx; margin-top: 22rpx; }
.address-text { color: #3d4d48; font-size: 25rpx; }
.distance-value { color: #8b9692; font-size: 22rpx; }
.mini-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }
.mini-btn { min-width: 154rpx; height: 60rpx; margin: 0; display: flex; align-items: center; justify-content: center; gap: 7rpx; border-radius: 16rpx; color: #0b735e; background: #e4f5ee; font-size: 23rpx; line-height: 1; }
.mini-btn::after { border: none; }
.mini-btn-icon { width: 28rpx; height: 28rpx; }

.service-card { margin-bottom: 24rpx; }
.section-head { margin-bottom: 24rpx; }
.service-grid { display: flex; flex-wrap: wrap; padding-top: 24rpx; }
.service-item { width: 20%; display: flex; flex-direction: column; align-items: center; margin-bottom: 18rpx; }
.service-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx; border-radius: 18rpx; font-size: 23rpx; font-weight: 700; }
.icon-available { color: #0b735e; background: #e0f6ee; }
.icon-unavailable { color: #8d9894; background: #edf1ef; }
.service-name { color: #485752; font-size: 21rpx; }
.name-unavailable { color: #9ba5a1; }

.bottom-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 99; display: flex; align-items: center; gap: 14rpx; padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); backdrop-filter: blur(20rpx); box-shadow: 0 -10rpx 30rpx rgba(13,49,41,.08); }
.bottom-btn { flex: 1; height: 86rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; gap: 9rpx; border-radius: 24rpx; font-size: 27rpx; font-weight: 700; }
.bottom-btn::after { border: none; }
.bottom-btn-icon { width: 36rpx; height: 36rpx; }
.btn-nav { color: #0b4c40; background: #e7efec; }
.btn-park { color: #ffffff; background: linear-gradient(135deg,#0b3b34,#159b78); box-shadow: 0 10rpx 24rpx rgba(21,155,120,.25); }

.reserve-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 999; display: flex; align-items: flex-end; justify-content: center; background: rgba(5,22,19,.62); backdrop-filter: blur(8rpx); }
.reserve-modal { width: 100%; padding: 28rpx 30rpx calc(env(safe-area-inset-bottom) + 30rpx); border-radius: 36rpx 36rpx 0 0; background: #ffffff; animation: slideUp .25s ease-out; box-sizing: border-box; }
.modal-drag-bar { width: 76rpx; height: 7rpx; margin: 0 auto 26rpx; border-radius: 99rpx; background: #d6ddda; }
.modal-heading { display: block; margin-bottom: 30rpx; color: #10231f; font-size: 34rpx; font-weight: 700; text-align: center; }
.vehicle-selector-label, .field-title { display: block; margin-bottom: 12rpx; color: #6f7b77; font-size: 23rpx; }
.vehicle-scroll { width: 100%; margin-bottom: 24rpx; white-space: nowrap; }
.vehicle-list { display: inline-flex; gap: 12rpx; }
.vehicle-chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 13rpx 20rpx; border: 2rpx solid transparent; border-radius: 999rpx; background: #edf1ef; }
.vehicle-chip.active { border-color: #159b78; background: #e2f6ef; }
.chip-plate { color: #10231f; font-size: 24rpx; font-weight: 700; }
.chip-default-tag { color: #0b735e; font-size: 19rpx; }
.form-item { margin-bottom: 24rpx; }
.field-input { width: 100%; height: 82rpx; padding: 0 22rpx; border: 2rpx solid #e0e6e3; border-radius: 18rpx; color: #10231f; background: #f7f9f8; font-size: 27rpx; box-sizing: border-box; }
.field-price { display: block; color: #0d8f70; font-size: 26rpx; font-weight: 700; }
.modal-actions { display: flex; gap: 14rpx; margin-top: 30rpx; }
.modal-btn { flex: 1; height: 82rpx; margin: 0; border-radius: 22rpx; font-size: 27rpx; font-weight: 700; line-height: 82rpx; }
.modal-btn::after { border: none; }
.btn-cancel { color: #66736e; background: #edf1ef; }
.btn-confirm { color: #ffffff; background: linear-gradient(135deg,#0b3b34,#159b78); }
.btn-confirm[disabled] { color: #ffffff; background: #99c9ba; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
