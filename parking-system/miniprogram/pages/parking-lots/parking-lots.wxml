<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px">
    <view class="header-top">
      <text class="header-title">发现停车</text>
      <text class="header-subtitle">筛选附近空闲车位</text>
    </view>

    <view class="search-bar">
      <view class="search-symbol"></view>
      <input
        class="search-input"
        placeholder="搜索停车场名称、地址"
        placeholder-class="placeholder"
        bindinput="onSearchInput"
        value="{{keyword}}"
        confirm-type="search"
      ></input>
      <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">
        <text class="clear-icon">✕</text>
      </view>
    </view>

    <scroll-view class="filter-bar" scroll-x enable-flex>
      <view
        class="filter-tag {{filterType === 'all' ? 'active' : ''}}"
        bindtap="onFilterTap"
        data-type="all"
      >全部</view>
      <view
        class="filter-tag {{filterType === 'available' ? 'active' : ''}}"
        bindtap="onFilterTap"
        data-type="available"
      >有空位</view>
      <view
        class="filter-tag {{filterType === 'distance' ? 'active' : ''}}"
        bindtap="onFilterTap"
        data-type="distance"
      >距离最近</view>
      <view
        class="filter-tag {{filterType === 'price' ? 'active' : ''}}"
        bindtap="onFilterTap"
        data-type="price"
      >价格最低</view>
    </scroll-view>
  </view>

  <scroll-view
    scroll-y
    class="list-scroll"
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    lower-threshold="100"
  >
    <view class="loading-wrap" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:if="{{!loading}}">
      <view class="list-head" wx:if="{{filteredList.length > 0}}">
        <text class="list-title">为你推荐</text>
        <text class="list-count">{{filteredList.length}}个停车场</text>
      </view>

      <block wx:if="{{filteredList.length > 0}}">
        <view
          class="parking-card"
          wx:for="{{filteredList}}"
          wx:key="id"
          bindtap="navigateToDetail"
          data-id="{{item.id}}"
        >
          <view class="card-image-wrap">
            <image class="card-image" src="{{item.bannerImage}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>
            <view wx:if="{{!item.bannerImage}}" class="card-image-placeholder">
              <text class="placeholder-text">P</text>
            </view>
            <view class="card-distance-tag">
              <text class="distance-text">{{item.distance || '未知距离'}}</text>
            </view>
            <view class="card-walk-tag" wx:if="{{item.walkTime && item.validDistance}}">
              <text class="walk-text">步行{{item.walkTime}}</text>
            </view>
          </view>

          <view class="card-content">
            <text class="card-name">{{item.name}}</text>
            <view class="card-address-row">
              <image class="card-address-icon" src="/images/location.png" mode="aspectFit"></image>
              <text class="card-address">{{item.address || '暂无地址信息'}}</text>
            </view>
            <view class="card-bottom-row">
              <view class="card-main-info">
                <view class="card-price-wrap">
                  <text class="price-symbol">¥</text>
                  <text class="price-value">{{item.hourlyRate}}</text>
                  <text class="price-unit">/小时</text>
                </view>
                <view class="card-divider"></view>
                <view class="card-space-wrap">
                  <text class="space-prefix">剩余</text>
                  <text class="space-text">{{item.availableSpaces || 0}}</text>
                  <text class="space-total">/{{item.totalSpaces || 0}}</text>
                </view>
              </view>
              <view class="card-go-btn">
                <text class="go-btn-text">去停车</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view class="empty-wrap" wx:if="{{filteredList.length === 0}}">
        <image class="empty-img" src="/images/empty.png" mode="aspectFit"></image>
        <text class="empty-text">暂无停车场数据</text>
      </view>

      <view class="list-bottom" wx:if="{{filteredList.length > 0}}">
        <text class="list-bottom-text">— 已加载全部 —</text>
      </view>

      <view class="list-safe-bottom"></view>
    </view>
  </scroll-view>
</view>
