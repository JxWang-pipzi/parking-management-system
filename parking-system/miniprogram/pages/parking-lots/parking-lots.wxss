.page {
  height: 100vh;
  background-color: #f7f7f7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: linear-gradient(180deg, #18B566 0%, #1dbf6e 100%);
  padding: 20rpx 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 181, 102, 0.12);
}

.header-top {
  margin-bottom: 24rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: rgba(255, 255, 255, 0.96);
  border-radius: 44rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  height: 72rpx;
  line-height: 72rpx;
}

.placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.clear-icon {
  font-size: 22rpx;
  color: #94a3b8;
}

.filter-bar {
  margin-top: 20rpx;
  white-space: nowrap;
  display: flex;
  flex-direction: row;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: 44rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  background-color: rgba(255, 255, 255, 0.14);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.filter-tag.active {
  color: #18B566;
  background-color: #ffffff;
  font-weight: 600;
}

.list-wrap {
  padding: 20rpx 28rpx;
}

.list-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.list-bottom {
  text-align: center;
  padding: 32rpx 0 48rpx;
}

.list-safe-bottom {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.list-bottom-text {
  font-size: 22rpx;
  color: #c4c4c4;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 20rpx;
}

.list-title {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 700;
}

.list-count {
  font-size: 22rpx;
  color: #9ca3af;
}

.parking-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.parking-card:active {
  opacity: 0.85;
}

.card-image-wrap {
  position: relative;
  width: 100%;
  height: 288rpx;
}

.card-image {
  width: 100%;
  height: 100%;
  background-color: #e2e8f0;
}

.card-image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #18B566 0%, #0ea05a 100%);
}

.placeholder-text {
  font-size: 80rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.3);
}

.card-distance-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background-color: #18B566;
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
}

.distance-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

.card-walk-tag {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  background-color: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
}

.walk-text {
  font-size: 22rpx;
  color: #374151;
}

.card-content {
  padding: 24rpx 28rpx 28rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  margin-bottom: 8rpx;
}

.card-address-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-address-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.card-address {
  font-size: 24rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.card-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-main-info {
  display: flex;
  align-items: center;
  min-width: 0;
}

.card-price-wrap {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: #FF6B35;
}

.price-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #FF6B35;
}

.price-unit {
  font-size: 20rpx;
  color: #c4c4c4;
  font-weight: 400;
  margin-left: 4rpx;
}

.card-divider {
  width: 2rpx;
  height: 44rpx;
  background-color: #e5e7eb;
  margin: 0 20rpx;
}

.card-space-wrap {
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: #6b7280;
}

.space-prefix {
  margin-right: 4rpx;
}

.space-text {
  font-size: 28rpx;
  color: #18B566;
  font-weight: 700;
}

.space-total {
  font-size: 22rpx;
  color: #9ca3af;
}

.card-go-btn {
  background-color: #18B566;
  border-radius: 36rpx;
  padding: 14rpx 30rpx;
  margin-left: 16rpx;
}

.go-btn-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 28rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #18B566;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
}
