.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f2f5f3;
}

.header {
  position: relative;
  z-index: 20;
  padding: 22rpx 28rpx 26rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 94% 8%, rgba(184, 242, 78, 0.2), transparent 34%),
    linear-gradient(145deg, #071f1c, #0b3b34 62%, #12604e);
  box-shadow: 0 20rpx 46rpx rgba(7, 39, 33, 0.16);
}

.header-top { margin-bottom: 22rpx; }
.header-kicker { display: block; color: #b8f24e; font-size: 19rpx; letter-spacing: 4rpx; font-weight: 700; }
.header-title { display: block; margin-top: 12rpx; color: #ffffff; font-size: 42rpx; font-weight: 700; }
.header-subtitle { display: block; margin-top: 6rpx; color: rgba(255,255,255,.62); font-size: 23rpx; }

.overview-strip {
  display: flex;
  align-items: center;
  margin: 0 0 20rpx;
  padding: 16rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,.08);
  border: 1rpx solid rgba(255,255,255,.12);
}
.overview-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.overview-value { color: #ffffff; font-size: 29rpx; font-weight: 700; }
.overview-label { color: rgba(255,255,255,.56); font-size: 19rpx; }
.overview-line { width: 1rpx; height: 40rpx; background: rgba(255,255,255,.13); }

.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(0,0,0,.12);
}
.search-symbol { position: relative; width: 21rpx; height: 21rpx; margin: 0 18rpx 0 4rpx; border: 4rpx solid #8d9894; border-radius: 50%; flex-shrink: 0; }
.search-symbol::after { content: ''; position: absolute; right: -10rpx; bottom: -5rpx; width: 11rpx; height: 4rpx; border-radius: 4rpx; background: #8d9894; transform: rotate(45deg); }
.search-input { flex: 1; height: 76rpx; line-height: 76rpx; color: #10231f; font-size: 28rpx; }
.placeholder { color: #98a39f; font-size: 27rpx; }
.clear-btn { width: 42rpx; height: 42rpx; border-radius: 50%; background: #edf1ef; display: flex; align-items: center; justify-content: center; }
.clear-icon { color: #75807c; font-size: 24rpx; }

.filter-bar { display: flex; white-space: nowrap; margin-top: 18rpx; }
.filter-tag { display: inline-flex; align-items: center; justify-content: center; margin-right: 12rpx; padding: 10rpx 24rpx; border-radius: 999rpx; color: rgba(255,255,255,.7); background: rgba(255,255,255,.08); border: 1rpx solid rgba(255,255,255,.1); font-size: 23rpx; }
.filter-tag.active { color: #0b4c40; background: #b8f24e; border-color: #b8f24e; font-weight: 700; }

.list-scroll { flex: 1; min-height: 0; box-sizing: border-box; padding: 22rpx 24rpx 0; }
.list-head { display: flex; align-items: baseline; justify-content: space-between; margin: 4rpx 4rpx 18rpx; }
.list-title { color: #10231f; font-size: 30rpx; font-weight: 700; }
.list-count { color: #8f9a96; font-size: 21rpx; }

.parking-card {
  display: flex;
  min-height: 214rpx;
  padding: 14rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(16,35,31,.05);
  box-shadow: 0 14rpx 34rpx rgba(19,55,47,.07);
}
.parking-card:active { opacity: .88; }
.card-image-wrap { position: relative; width: 210rpx; min-height: 214rpx; overflow: hidden; border-radius: 21rpx; flex-shrink: 0; background: #dfe7e4; }
.card-image { width: 100%; height: 100%; }
.card-image-placeholder { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg,#0a332d,#159b78); }
.placeholder-text { color: rgba(255,255,255,.35); font-size: 72rpx; font-weight: 800; }
.card-distance-tag, .card-walk-tag { position: absolute; top: 12rpx; padding: 6rpx 12rpx; border-radius: 999rpx; backdrop-filter: blur(12rpx); }
.card-distance-tag { left: 12rpx; background: rgba(7,31,28,.78); }
.card-walk-tag { right: 12rpx; background: rgba(255,255,255,.9); }
.distance-text { color: #ffffff; font-size: 19rpx; font-weight: 600; }
.walk-text { color: #30423d; font-size: 19rpx; }

.card-content { flex: 1; min-width: 0; padding: 8rpx 6rpx 4rpx 20rpx; display: flex; flex-direction: column; }
.card-name { display: block; color: #10231f; font-size: 28rpx; line-height: 1.35; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-address-row { display: flex; align-items: center; margin-top: 12rpx; }
.card-address-icon { width: 22rpx; height: 22rpx; margin-right: 8rpx; }
.card-address { flex: 1; color: #899591; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-bottom-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: auto; padding-top: 16rpx; }
.card-main-info { min-width: 0; }
.card-price-wrap { display: flex; align-items: baseline; }
.price-symbol { color: #ed7943; font-size: 19rpx; font-weight: 700; }
.price-value { color: #ed7943; font-size: 36rpx; font-weight: 800; line-height: 1; }
.price-unit { color: #9aa4a0; font-size: 18rpx; margin-left: 3rpx; }
.card-divider { display: none; }
.card-space-wrap { display: flex; align-items: baseline; margin-top: 9rpx; color: #74807c; font-size: 20rpx; }
.space-prefix { margin-right: 4rpx; }
.space-text { color: #159b78; font-size: 24rpx; font-weight: 700; }
.space-total { color: #9ba5a1; font-size: 19rpx; }
.card-go-btn { padding: 13rpx 20rpx; border-radius: 16rpx; background: #0b3b34; }
.go-btn-text { color: #ffffff; font-size: 21rpx; font-weight: 700; }

.loading-wrap, .empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 110rpx 0; }
.loading-spinner { width: 44rpx; height: 44rpx; border: 4rpx solid #dce5e1; border-top-color: #159b78; border-radius: 50%; animation: spin .8s linear infinite; }
.loading-text, .empty-text { margin-top: 18rpx; color: #8d9894; font-size: 24rpx; }
.empty-img { width: 180rpx; height: 180rpx; }
.list-bottom { text-align: center; padding: 26rpx 0 40rpx; }
.list-bottom-text { color: #adb6b2; font-size: 20rpx; }
.list-safe-bottom { height: calc(166rpx + env(safe-area-inset-bottom)); }
@keyframes spin { to { transform: rotate(360deg); } }
