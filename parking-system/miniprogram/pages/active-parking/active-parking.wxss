.active-parking-page {
  min-height: 100vh;
  background-color: #f6f8f7;
  padding: 0 24rpx 44rpx;
  box-sizing: border-box;
}

.hero {
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 132rpx;
  background: linear-gradient(135deg, #06b46f 0%, #009d59 100%);
  border-radius: 0 0 18rpx 18rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title,
.hero-subtitle {
  display: block;
  color: #ffffff;
}

.hero-title {
  font-size: 30rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.plate-card {
  margin-top: 34rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 30rpx 24rpx 28rpx;
  position: relative;
  top: 88rpx;
}

.plate-box {
  height: 70rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.plate-number {
  font-size: 30rpx;
  font-weight: 800;
  color: #121826;
}

.edit-icon {
  font-size: 22rpx;
  color: #354052;
}

.lot-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #20242e;
  margin-bottom: 8rpx;
}

.floor-text {
  display: block;
  color: #8c96a3;
  font-size: 20rpx;
}

.info-card {
  margin-top: -18rpx;
  background-color: #ffffff;
  border-radius: 0 0 10rpx 10rpx;
  padding: 26rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 22rpx;
  color: #87909d;
}

.info-value {
  font-size: 22rpx;
  color: #1a1a1a;
}

.info-green {
  color: #18B566;
  font-weight: 500;
}

.info-orange {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.free-tip {
  display: block;
  color: #08a95c;
  font-size: 20rpx;
  margin-top: 12rpx;
}

.action-card {
  margin-top: 22rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  display: flex;
  justify-content: space-around;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 34rpx;
  color: #283241;
}

.action-text {
  color: #5f6875;
  font-size: 20rpx;
}

.pay-btn {
  width: 100%;
  height: 86rpx;
  line-height: 86rpx;
  text-align: center;
  background-color: #05a95e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 10rpx;
  margin-top: 22rpx;
}

.tips-card {
  margin-top: 22rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.tips-title {
  display: block;
  font-size: 24rpx;
  color: #20242e;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.tips-text,
.tips-footer {
  display: block;
  color: #8c96a3;
  font-size: 20rpx;
  line-height: 1.7;
}

.tips-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.open-link {
  color: #08a95c;
}

.location-card {
  margin-top: 22rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.location-row {
  display: flex;
  align-items: flex-start;
}

.location-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(24, 181, 102, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.location-icon {
  width: 32rpx;
  height: 32rpx;
}

.location-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.location-label,
.location-address,
.location-spot {
  font-size: 22rpx;
}

.location-label {
  color: #999999;
}

.location-address {
  color: #1a1a1a;
}

.location-spot {
  color: #18B566;
  font-weight: 500;
}
