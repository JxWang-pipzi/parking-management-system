.page {
  min-height: 100vh;
  background: #f6f8fb;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.settings-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
}

.settings-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.settings-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 18rpx;
}

.value {
  display: block;
  font-size: 26rpx;
  color: #18b566;
  word-break: break-all;
  margin-bottom: 12rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.preset-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.preset-item {
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  padding: 22rpx;
}

.preset-head {
  margin-bottom: 10rpx;
}

.preset-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.preset-url {
  display: block;
  font-size: 24rpx;
  color: #18b566;
  word-break: break-all;
}

.preset-desc {
  display: block;
  font-size: 23rpx;
  color: #6b7280;
  line-height: 1.6;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #111827;
  background: #fff;
  margin-bottom: 12rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.actions.single {
  display: block;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #18b566;
  color: #ffffff;
}

.btn.ghost {
  background: #ffffff;
  color: #18b566;
  border: 2rpx solid #18b566;
}

.btn.light {
  background: #eef2f7;
  color: #475569;
}

.btn.probe {
  background: #ffffff;
  color: #3b82f6;
  border: 2rpx solid #3b82f6;
}

.tip-line {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
