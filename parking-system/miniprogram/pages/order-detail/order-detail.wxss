.page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 150rpx;
}

.plain-nav {
  background: #ffffff;
  padding: 12rpx 24rpx 10rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  height: 72rpx;
  gap: 20rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  color: #111827;
  font-size: 42rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.glass-back {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(209, 213, 219, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(18rpx);
}

.title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 0;
}

.content {
  padding: 28rpx 24rpx;
}

.section {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 24rpx 0;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
}

.section-title {
  display: block;
  color: #20242e;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0 24rpx 18rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 15rpx 24rpx;
}

.pay-method-row:active {
  background-color: #f7f8fa;
}

.info-label {
  color: #8f96a3;
  font-size: 26rpx;
  flex-shrink: 0;
}

.info-value {
  color: #20242e;
  font-size: 26rpx;
  text-align: right;
}

.muted {
  color: #8f96a3;
}

.plate {
  font-weight: 800;
  letter-spacing: 4rpx;
}

.amount {
  color: #07C160;
  font-size: 40rpx;
  font-weight: 800;
}

.success-content {
  padding-top: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.amount-content {
  padding: 46rpx 24rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pay-amount {
  color: #111827;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.2;
}

.pay-label {
  color: #8c96a3;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.success-icon {
  width: 86rpx;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 50%;
  text-align: center;
  background: #07a85a;
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.success-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.success-amount {
  font-size: 42rpx;
  color: #111827;
  font-weight: 800;
}

.method-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.method-icon,
.method-fallback {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.method-fallback {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.blue {
  background: #2e9bff;
}

.gray {
  background: #687384;
}

.radio {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #cdd3da;
  color: #ffffff;
  text-align: center;
  line-height: 28rpx;
  font-size: 18rpx;
}

.radio.active {
  background: #07a85a;
  border-color: #07a85a;
}

.empty {
  padding: 100rpx 32rpx;
  text-align: center;
}

.empty-text {
  color: #8f96a3;
  font-size: 30rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.success-actions {
  flex-direction: row;
  gap: 18rpx;
}

.primary-btn,
.secondary-btn,
.outline-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn {
  background: #07C160;
  color: #ffffff;
}

.outline-btn {
  background: #ffffff;
  color: #07C160;
  border: 2rpx solid #07C160;
  margin-top: 0;
}

.secondary-btn {
  background: #eef2f1;
  color: #20242e;
}

.full-btn {
  width: 100%;
}

.success-actions .full-btn {
  width: auto;
}

button::after {
  border: none;
}
