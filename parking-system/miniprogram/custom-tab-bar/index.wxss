.tabbar-wrap { position: fixed; right: 0; bottom: 0; left: 0; z-index: 999; pointer-events: none; }
.tabbar-bg { position: absolute; right: 18rpx; bottom: calc(12rpx + env(safe-area-inset-bottom)); left: 18rpx; height: 108rpx; border-radius: 30rpx; background: rgba(255,255,255,.96); border: 1rpx solid rgba(16,35,31,.08); box-shadow: 0 18rpx 46rpx rgba(12,48,40,.16); backdrop-filter: blur(24rpx); }
.tabbar { position: relative; display: flex; align-items: flex-end; justify-content: space-between; padding: 12rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); pointer-events: auto; }
.tab-side { flex: 1; display: flex; align-items: flex-end; justify-content: space-around; }
.tab-side-right { padding-left: 24rpx; }
.tab-item { min-width: 72rpx; display: flex; flex-direction: column; align-items: center; gap: 5rpx; }
.tab-icon { width: 39rpx; height: 39rpx; }
.tab-text { color: #87928e; font-size: 19rpx; line-height: 1.2; }
.is-active .tab-text { color: #0b735e; font-weight: 700; }
.is-active::before { content: ''; width: 34rpx; height: 4rpx; margin-bottom: 2rpx; border-radius: 99rpx; background: #159b78; }
.scan-trigger { width: 106rpx; margin-top: -42rpx; display: flex; flex-direction: column; align-items: center; gap: 5rpx; flex-shrink: 0; }
.scan-button { width: 92rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; background: linear-gradient(145deg,#0b3b34,#159b78); border: 7rpx solid #ffffff; box-shadow: 0 14rpx 28rpx rgba(21,155,120,.3); transform: rotate(45deg); }
.scan-icon { width: 39rpx; height: 39rpx; transform: rotate(-45deg); }
.scan-text { color: #0b735e; font-size: 19rpx; font-weight: 700; line-height: 1.2; }
