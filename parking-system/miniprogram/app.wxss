page {
  background-color: #f2f5f3;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx;
  color: #10231f;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(16, 35, 31, 0.05);
  box-shadow: 0 12rpx 30rpx rgba(18, 52, 44, 0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #0b3b34 0%, #159b78 100%);
  color: #ffffff;
  border-radius: 44rpx;
  padding: 22rpx 44rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: #0b735e;
}

.btn-outline {
  background-color: #ffffff;
  color: #0b735e;
  border: 3rpx solid #159b78;
  border-radius: 44rpx;
  padding: 22rpx 44rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-outline::after {
  border: none;
}

.input {
  background-color: #f8fafc;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e2e8f0;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 44rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 10rpx;
}

.tag-success {
  background-color: rgba(7, 193, 96, 0.1);
  color: #159b78;
}

.tag-danger {
  background-color: #fee2e2;
  color: #991b1b;
}

.tag-warning {
  background-color: #fef3c7;
  color: #92400e;
}

.tag-info {
  background-color: #f1f5f9;
  color: #475569;
}

.divider {
  height: 1rpx;
  background-color: #f1f5f5;
  margin: 24rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state text {
  color: #94a3b8;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.text-primary {
  color: #159b78;
}

.text-success {
  color: #159b78;
}

.text-danger {
  color: #FF6B35;
}

.text-warning {
  color: #FFB800;
}

.text-info {
  color: #94a3b8;
}

.text-bold {
  font-weight: 700;
}

.text-center {
  text-align: center;
}

.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-20 { padding: 20rpx; }

.glass-back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(209, 213, 219, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
  backdrop-filter: blur(18rpx);
  color: #111827;
  font-size: 42rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 400;
  flex-shrink: 0;
}

.floating-glass-back {
  position: fixed;
  left: 24rpx;
  z-index: 200;
}
