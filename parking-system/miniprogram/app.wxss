page {
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background-color: #18B566;
  color: #ffffff;
  border-radius: 44rpx;
  padding: 22rpx 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: #15a05a;
}

.btn-outline {
  background-color: #ffffff;
  color: #18B566;
  border: 4rpx solid #18B566;
  border-radius: 44rpx;
  padding: 22rpx 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-outline::after {
  border: none;
}

.input {
  background-color: #f8fafc;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e2e8f0;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 44rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 10rpx;
}

.tag-success {
  background-color: rgba(24, 181, 102, 0.1);
  color: #18B566;
}

.tag-danger {
  background-color: #fee2e2;
  color: #991b1b;
}

.tag-warning {
  background-color: #fef3c7;
  color: #92400e;
}

.tag-info {
  background-color: #f1f5f9;
  color: #475569;
}

.divider {
  height: 1rpx;
  background-color: #f1f5f5;
  margin: 24rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state text {
  color: #94a3b8;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.text-primary {
  color: #18B566;
}

.text-success {
  color: #18B566;
}

.text-danger {
  color: #FF6B35;
}

.text-warning {
  color: #FFB800;
}

.text-info {
  color: #94a3b8;
}

.text-bold {
  font-weight: 700;
}

.text-center {
  text-align: center;
}

.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-20 { padding: 20rpx; }
